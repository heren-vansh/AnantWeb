    <!-- Scripts -->
    <script>
        // Navbar Scroll Effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 50) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');
        });

        // Mobile Menu Toggle
        function toggleMenu() {
            const navLinks = document.getElementById('navLinks');
            navLinks.classList.toggle('active');
        }

        // Close Floating Video
        function closeFloatingVideo() {
            const videoContainer = document.getElementById('floatingVideo');
            videoContainer.style.transform = 'scale(0)';
            setTimeout(() => { videoContainer.style.display = 'none'; }, 400);
        }

        // Counter Animation for Stats
        const counters = document.querySelectorAll('.counter');
        const speed = 50; 

        const animateCounters = () => {
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                const count = +counter.innerText;
                const inc = target / speed;

                if (count < target) {
                    counter.innerText = Math.ceil(count + inc);
                    setTimeout(animateCounters, 40);
                } else {
                    // Logic to avoid "+" duplicating if it was already handled in HTML structure,
                    // Note: Handled properly in updated HTML span structure above.
                    counter.innerText = target;
                }
            });
        }

        // Trigger Counter Animation on scroll
        let observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateCounters();
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.5 });

        document.querySelector('.stats-section').querySelectorAll('.counter').forEach(c => observer.observe(c));

        // Scroll Animation Trigger for Elements
        const animateElements = document.querySelectorAll('.animate-up');
        const scrollObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.style.animationPlayState = 'running';
                }
            })
        });
        animateElements.forEach(el => {
            el.style.animationPlayState = 'paused';
            scrollObserver.observe(el);
        });
        // --- Firebase Logic ---
        // Tamara Firebase Console mathi 'Config' ahiya paste karo
        const firebaseConfig = {
            apiKey: "AIzaSyDoGy8SUrEDJ9ody4p7YA-_1nABssJcCbs",
            authDomain: "anantweb-12da0.firebaseapp.com",
            projectId: "anantweb-12da0",
            storageBucket: "anantweb-12da0.firebasestorage.app",
            messagingSenderId: "636221130786",
            appId: "1:636221130786:web:2cdf8cb379c9a4ea7e627b",
            measurementId: "G-J6ZBCM4VGF"
            };

        // Initialize Firebase
        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const googleProvider = new firebase.auth.GoogleAuthProvider();

        let isLoginMode = true;

        function toggleAuthMode() {
            isLoginMode = !isLoginMode;
            document.getElementById('authTitle').innerText = isLoginMode ? "SIGN IN" : "SIGN UP";
            document.querySelector('.switch-auth').innerHTML = isLoginMode ? "Don't have an account? <span>Sign Up</span>" : "Already have an account? <span>Sign In</span>";
        }

       function handleAuth() {
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const errorDisplay = document.getElementById('authError');
    
    // Pela error msg clear kari do
    errorDisplay.innerText = "";
    errorDisplay.style.color = "#ff4a00"; // Aapni orange theme warning

    // Khali input check
    if (!email || !password) {
        errorDisplay.innerText = "Email ane Password banne nakhva jaruri che!";
        return;
    }

    if(isLoginMode) {
        // --- SIGN IN LOGIC ---
        auth.signInWithEmailAndPassword(email, password)
            .then((userCredential) => {
                alert("Login Successful! Welcome to Anant Krupa.");
                document.getElementById('loginModal').style.display = 'none';
                document.getElementById('email').value = "";
                document.getElementById('password').value = "";
            })
            .catch((error) => { 
                // Error Pakadvani System
                console.log(error.code); // Console ma check karva mate
                if (error.code === 'auth/wrong-password') {
                    errorDisplay.innerText = "Your Pass Was Wrong.";
                } else if (error.code === 'auth/user-not-found') {
                    errorDisplay.innerText = "❌ This Email is not registred, please sign-up.";
                } else if (error.code === 'auth/invalid-credential') {
                    errorDisplay.innerText = "❌ Your email or pass was wrong";
                } else if (error.code === 'auth/invalid-email') {
                    errorDisplay.innerText = "❌ Email's id format was wrong";
                } else {
                    errorDisplay.innerText = "❌ " + error.message;
                }
            });
    } else {
        // --- SIGN UP LOGIC ---
        auth.createUserWithEmailAndPassword(email, password)
            .then((userCredential) => {
                alert("Account Created Successfully! You are come Anant World");
                document.getElementById('loginModal').style.display = 'none';
                document.getElementById('email').value = "";
                document.getElementById('password').value = "";
            })
            .catch((error) => { 
                // Sign Up vakhate aavti Errors
                if (error.code === 'auth/email-already-in-use') {
                    errorDisplay.innerText = "⚠️ This email id have alredy account, please try another account";
                } else if (error.code === 'auth/weak-password') {
                    errorDisplay.innerText = "⚠️ Password make strong(Minimum 6 latter).";
                } else {
                    errorDisplay.innerText = "⚠️ " + error.message;
                }
            });
    }
}   

        // User login che ke nahi e check karva
        auth.onAuthStateChanged((user) => {
            const loginBtn = document.getElementById('navLoginBtn');
            if (user) {
                loginBtn.innerText = "LOGOUT";
                loginBtn.onclick = () => auth.signOut();
            } else {
                loginBtn.innerText = "LOGIN";
                loginBtn.onclick = () => document.getElementById('loginModal').style.display='flex';
            }
        });
        function signInWithGoogle() {
            const errorDisplay = document.getElementById('authError');
            errorDisplay.innerText = ""; // Clear old errors

            auth.signInWithPopup(googleProvider)
                .then((result) => {
                    const user = result.user;
                    alert("Welcome to Anant Krupa, " + user.displayName + "!");
                    document.getElementById('loginModal').style.display = 'none';
                })
                .catch((error) => {
                    console.log(error);
                    errorDisplay.innerText = "❌ Google Login Failed: " + error.message;
                });
        }
    </script>
</body>
</html>
