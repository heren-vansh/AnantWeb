<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anant Krupa - Premium Game Studio</title>
    <!-- Nava Premium Fonts: Oswald for Aggressive Headers, Montserrat for clean reading -->
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

        <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
    
    <style>
        :root {
            /* Navi Color Scheme: Fiery Orange and Deep Graphite */
            --primary: #ff4a00; 
            --primary-hover: #ff7300;
            --dark: #0a0a0c;
            --card-bg: #15151a;
            --glass: rgba(10, 10, 12, 0.9);
            --text-muted: #8b8b99;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--dark);
            color: #fff;
            overflow-x: hidden;
            background-image: radial-gradient(circle at top right, #1f120e 0%, transparent 40%);
        }

        /* --- Custom Scrollbar --- */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--dark); }
        ::-webkit-scrollbar-thumb { background: var(--primary); }

        /* --- Animations (Khatarnak Entry) --- */
        @keyframes slideInUp {
            from { transform: translateY(80px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .animate-up {
            animation: slideInUp 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
            opacity: 0;
        }

        .delay-1 { animation-delay: 0.2s; }
        .delay-2 { animation-delay: 0.4s; }
        .delay-3 { animation-delay: 0.6s; }

        /* --- Navbar & Logo --- */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: transparent;
            z-index: 1000;
            transition: all 0.4s ease;
        }

        nav.scrolled {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 74, 0, 0.2);
            padding: 15px 50px;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #fff;
            font-family: 'Oswald', sans-serif;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Sharp Logo Icon - Cut Corner Style */
        .brand-icon {
            display: inline-block;
            width: 35px;
            height: 35px;
            background: var(--primary);
            position: relative;
            margin-right: 15px;
            clip-path: polygon(20% 0%, 100% 0%, 80% 100%, 0% 100%);
        }

        .nav-links {
            display: flex;
            gap: 35px;
            align-items: center;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-size: 15px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            background: var(--primary);
            bottom: -5px;
            left: 0;
            transition: width 0.3s;
        }

        .nav-links a:hover { color: var(--primary); }
        .nav-links a:hover::after { width: 100%; }

        .login-btn {
            border: 2px solid var(--primary);
            padding: 10px 30px;
            background: transparent;
            color: var(--primary);
            font-weight: 800;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%); /* Futuristic cut corner */
        }

        .login-btn:hover {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 0 20px rgba(255, 74, 0, 0.5);
        }

        .menu-toggle {
            display: none;
            font-size: 30px;
            color: var(--primary);
            cursor: pointer;
        }

        /* --- Hero Section with Action Video --- */
        .hero {
            height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
        }

        .hero-video {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100%;
            min-height: 100%;
            z-index: -2;
            object-fit: cover;
            /* Video filter for darker, aggressive look */
            filter: brightness(0.5) contrast(1.2); 
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(0deg, rgba(10,10,12,1) 0%, rgba(10,10,12,0.1) 50%, rgba(10,10,12,0.8) 100%);
            z-index: -1;
        }

        .hero-content h1 {
            font-family: 'Oswald', sans-serif;
            font-size: 6.5rem;
            font-weight: 700;
            text-transform: uppercase;
            text-shadow: 0 5px 15px rgba(0,0,0,0.8);
            margin-bottom: 20px;
            letter-spacing: 4px;
            line-height: 1.1;
        }

        .hero-content h1 span {
            color: var(--primary);
        }

        .hero-content p {
            font-size: 1.5rem;
            letter-spacing: 2px;
            color: #ddd;
            margin-bottom: 40px;
            font-weight: 400;
        }

        .explore-btn {
            padding: 16px 45px;
            font-size: 1.1rem;
            font-weight: 800;
            background: var(--primary);
            color: #fff;
            border: none;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: 0.3s;
            clip-path: polygon(15px 0%, 100% 0%, calc(100% - 15px) 100%, 0% 100%); /* Cut corners */
        }
        
        .explore-btn:hover {
            background: var(--primary-hover);
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(255, 74, 0, 0.4);
        }

        /* --- Stats / About Section --- */
        .stats-section {
            padding: 80px 50px;
            background: var(--card-bg);
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            position: relative;
        }
        
        .stats-section::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 2px;
            background: linear-gradient(90deg, transparent, var(--primary), transparent);
        }

        .stat-box {
            text-align: center;
            padding: 20px;
        }

        .stat-box h3 {
            font-family: 'Oswald', sans-serif;
            font-size: 4rem;
            color: #fff;
        }

        .stat-box h3 span {
            color: var(--primary);
        }

        .stat-box p {
            font-size: 1.1rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            margin-top: -5px;
        }

        /* --- Games Section --- */
        .section-title {
            text-align: center;
            font-family: 'Oswald', sans-serif;
            font-size: 4rem;
            margin: 100px 0 60px;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .section-title span {
            color: var(--primary);
        }

        .games-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 40px;
            padding: 0 50px;
        }

        .game-card {
            width: 450px;
            background: var(--card-bg);
            overflow: hidden;
            position: relative;
            cursor: pointer;
            transition: all 0.4s ease;
            clip-path: polygon(0 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%);
            border-left: 3px solid transparent;
        }

        .game-card:hover {
            transform: translateY(-10px);
            border-left: 3px solid var(--primary);
            box-shadow: -10px 15px 30px rgba(0,0,0,0.5);
        }

        .game-card img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            transition: transform 0.6s;
            filter: grayscale(30%);
        }

        .game-card:hover img {
            transform: scale(1.1);
            filter: grayscale(0%);
        }

        .info-overlay {
            position: absolute;
            bottom: 0;
            width: 100%;
            background: linear-gradient(to top, rgba(10,10,12,1) 0%, rgba(10,10,12,0) 100%);
            padding: 40px 20px 20px;
        }

        .info-overlay h3 {
            font-family: 'Oswald', sans-serif;
            font-size: 2.2rem;
            text-transform: uppercase;
        }

        .info-overlay p {
            color: var(--primary);
            margin-top: 5px;
            font-size: 1rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        /* --- Side Floating Video --- */
        .floating-video-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 320px;
            height: 180px;
            background: #000;
            z-index: 2000;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            border: 2px solid var(--card-bg);
            border-bottom: 2px solid var(--primary);
            transition: all 0.4s;
            animation: slideInUp 1.5s forwards;
            clip-path: polygon(0 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%);
        }

        .floating-video-container:hover {
            transform: scale(1.05);
        }

        .floating-video-container video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .close-video-btn {
            position: absolute;
            top: 0px;
            right: 0px;
            background: var(--primary);
            color: #fff;
            border: none;
            font-size: 14px;
            width: 30px;
            height: 30px;
            cursor: pointer;
            z-index: 2001;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.3s;
        }

        .close-video-btn:hover {
            background: #fff;
            color: var(--dark);
        }

        /* --- Footer --- */
        footer {
            background: var(--card-bg);
            padding: 60px 20px;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            margin-top: 100px;
        }

        .footer-logo {
            font-family: 'Oswald', sans-serif;
            font-size: 2.5rem;
            color: #fff;
            margin-bottom: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            text-transform: uppercase;
        }
        
        .footer-socials {
            margin: 25px 0;
            display: flex;
            gap: 25px;
            justify-content: center;
        }
        
        .footer-socials a {
            color: var(--text-muted);
            font-size: 24px;
            transition: color 0.3s;
        }
        
        .footer-socials a:hover { color: var(--primary); }

        /* --- Responsive --- */
        @media (max-width: 900px) {
            .hero-content h1 { font-size: 4.5rem; }
            .floating-video-container { width: 250px; height: 140px; bottom: 20px; right: 20px; }
        }

        @media (max-width: 768px) {
            nav { padding: 15px 20px; }
            .menu-toggle { display: block; }
            .nav-links {
                position: absolute;
                top: 70px;
                right: -100%;
                flex-direction: column;
                background: var(--glass);
                width: 100%;
                height: calc(100vh - 70px);
                padding-top: 40px;
                transition: right 0.4s ease;
            }
            .nav-links.active { right: 0; }
            .hero-content h1 { font-size: 3.5rem; }
            .stat-box { width: 50%; margin-bottom: 30px; }
            .games-grid { padding: 0 15px; }
            .floating-video-container { display: none; }
        }
        /* --- Login Modal --- */
            .login-modal {
                display: none; position: fixed; z-index: 3000; left: 0; top: 0; width: 100%; height: 100%;
                background-color: rgba(10, 10, 12, 0.95); backdrop-filter: blur(10px);
                justify-content: center; align-items: center;
            }
            .login-box {
                background: var(--card-bg); padding: 40px; width: 100%; max-width: 400px;
                border: 2px solid var(--primary);
                clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
                text-align: center; position: relative; animation: zoomIn 0.3s;
            }
            .login-box h2 { font-family: 'Oswald', sans-serif; font-size: 2rem; margin-bottom: 20px; color: #fff; }
            .login-box input {
                width: 100%; padding: 12px; margin-bottom: 15px; background: #0a0a0c;
                border: 1px solid #333; color: #fff; font-family: 'Montserrat', sans-serif; outline: none;
            }
            .login-box input:focus { border-color: var(--primary); }
            .close-login { position: absolute; top: 10px; right: 15px; color: #fff; font-size: 24px; cursor: pointer; }
            .auth-btn { width: 100%; padding: 12px; background: var(--primary); color: #fff; border: none; font-weight: bold; cursor: pointer; margin-bottom: 10px; text-transform: uppercase;}
            .auth-btn:hover { background: var(--primary-hover); }
            .switch-auth { color: var(--text-muted); font-size: 0.9rem; cursor: pointer; }
            .switch-auth span { color: var(--primary); 
        }
        .google-btn {
            background: #fff;
            color: #000;
            margin-top: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .google-btn:hover {
            background: #e5e5e5;
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
        }
    </style>
</head>
<body>

    <!-- Login Modal -->
    <div id="loginModal" class="login-modal">
